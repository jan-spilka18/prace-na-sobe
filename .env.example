# Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Servisní klíč. Obchází Row Level Security, proto ho aplikace používá výhradně
# na serveru při zakládání klientských účtů. Nikdy nesmí mít prefix NEXT_PUBLIC_
# a nikdy nepatří do gitu.
SUPABASE_SERVICE_ROLE_KEY=

# --- Notifikace (etapa 3 a 4) ---
# Vygeneruj v aplikaci: Klienti → Notifikace → Vygenerovat.
# Soukromé klíče patří jen do nastavení Vercelu, nikdy do gitu.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tvuj@email.cz

# Chrání /api/cron/* před cizím spuštěním. Bez něj se úlohy nespustí vůbec.
CRON_SECRET=

# E-mail se souhrnem. Nepovinné — bez nich chodí souhrn jen jako push.
RESEND_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_APP_URL=
